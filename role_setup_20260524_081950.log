### 14. Shared Terraform Module Pattern (`atlassian-monitoring-terraform-modules`)

**What it is**: Atlassian's centralized Terraform module library for standardized detector creation.

```hcl
module "prompt_mod_reliability" {
  source = "git::ssh://git@bitbucket.org/atlassian/atlassian-monitoring-terraform-modules.git//detectors?ref=7.8.0"
  variables = {
    team_context= var.team_context
    component_context = var.component_context
    name             = "Prompt Moderation Reliability"
    success_events   = { query = "data('http.server.requests.count', filter=...and (not filter('status', '5*')))..." }
    failure_events   = { query = "data('http.server.requests.count', filter=...and filter('status', '5*'))..." }
    success_rate_rules = {
      prod = {
        high = { duration = "5m", threshold = 99.9, severity = "Critical" }
        low  = { duration = "15m", threshold = 99.5, severity = "Warning" }
      }
    }
    error_count_rules = { prod = {} }
  }
}
```

**Source**: [LINNO-676: Replace duplicate code with atlassian-monitoring-terraform-modules](https://hello.atlassian.net/wiki/spaces/LINNO/pages/6649887667)

