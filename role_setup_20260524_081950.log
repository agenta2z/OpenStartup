       def _handle_malformed(                                                   
           self, error: MalformedModelOutput, context: ModerationContext        
       ) -> ModerationResult:                                                   
           """Handle malformed output — always fail open."""                    
           log.warning("Malformed model output, failing open: %s", error)       
           self._emit_fail_open("malformed_output", context)                    
           return self._fail_open(violation_score=0.0)                          
                                                                                
                                                                                

