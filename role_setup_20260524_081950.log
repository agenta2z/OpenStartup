### 3.3 Ray Budget Enforcement

**Ray Tune with Full Budget Gating**:
```python
from ray import tune
from ray.tune.schedulers import ASHAScheduler
from ray.tune.stopper import CombinedStopper, TimeoutStopper

class BudgetAwarePlateuStopper(tune.Stopper):
    """Custom stopper combining budget + convergence."""
    
    def __init__(self, budget_usd, cost_per_trial_second, patience=5, min_delta=0.001):
        self.budget_usd = budget_usd
        self.cost_per_trial_second = cost_per_trial_second
        self.patience = patience
        self.min_delta = min_delta
        self._best = {}
        self._wait = {}
        self._total_cost = 0
    
    def __call__(self, trial_id, result):
        # Track per-trial convergence
        metric = result["val_loss"]
        if trial_id not in self._best or metric < self._best[trial_id] - self.min_delta:
            self._best[trial_id] = metric
            self._wait[trial_id] = 0
        else:
            self._wait[trial_id] = self._wait.get(trial_id, 0) + 1
        
        return self._wait.get(trial_id, 0) >= self.patience
    
    def stop_all(self):
        """Global budget check across all trials."""
        return self._total_cost >= self.budget_usd

# Usage
tuner = tune.Tuner(
    trainable,
    tune_config=tune.TuneConfig(
        scheduler=ASHAScheduler(
            max_t=100,
            grace_period=5,
            reduction_factor=3,
        ),
        num_samples=20,
    ),
    run_config=tune.RunConfig(
        stop=BudgetAwarePlateuStopper(
            budget_usd=1000,
            cost_per_trial_second=0.02,
            patience=5,
        ),
    ),
)
```

