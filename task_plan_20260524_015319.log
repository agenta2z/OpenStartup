  string; agentBubble: string; systemBubble: string; toolBubble: string };\n    
  147 }\n 148 export interface SpacingTokens   { unit: number; scale:           
  number[]; }    // e.g. 4, [0,4,8,12,16,24,32,48]\n 149 export interface       
  RadiusTokens    { none: 0; sm: number; md: number; lg: number; pill: number;  
  }\n 150 export interface TypographyTokens {\n 151   fontFamily: { sans:       
  string; mono: string; };\n 152   size:   { xs:number; sm:number; md:number;   
  lg:number; xl:number; xxl:number; };\n 153   weight: { regular:number;        
  medium:number; semibold:number; bold:number; };\n 154   lineHeight: {         
  tight:number; normal:number; relaxed:number; };\n 155 }\n 156 export          
  interface ElevationTokens { 0:string; 1:string; 2:string; 3:string;           
  4:string; 5:string; }\n 157 export interface MotionTokens    {                
  duration:{fast:number;base:number;slow:number};                               
  easing:{standard:string;emphasized:string}; }\n 158 export interface          
  ZIndexTokens    { dropdown:number; sticky:number; drawer:number;              
  modal:number; popover:number; tooltip:number; }\n 159 \n 160 export           
  interface ThemeTokens {\n 161   name: string;\n 162   color: ColorTokens;\n   
  163   spacing: SpacingTokens;\n 164   radius: RadiusTokens;\n 165             
  typography: TypographyTokens;\n 166   elevation: ElevationTokens;\n 167       
  motion: MotionTokens;\n 168   zIndex: ZIndexTokens;\n 169 }\n 170 \n 171 \n   
  172 #### Generalization of existing pieces\n 173 - createAppTheme(tokens:     
  ThemeTokens, overrides?: DeepPartial<MuiTheme>) → MuiTheme — generalization   
  of rankevolve's createAppTheme(name, mode) which hard-codes palettes. Tokens  
  first, MUI overrides second.\n 174 - themeRegistry — Map<string,              
  ThemeTokens> runtime singleton scoped per-consumer (avoids React-version      
  module duplication). Ships with three defaults (light, dark, highContrast);   
  consumers register additional themes.\n 175 - ThemeProvider — wraps MUI       
  ThemeProvider + emotion CacheProvider + CssBaseline, and exposes raw tokens   
  via a React context so non-MUI components can read them.\n 176 -              
  ThemeSwitcher — headless hook (useThemeSwitcher()) + an opinionated MUI menu  
  built on top; uncontrolled+controlled prop pattern; onChange(themeName).\n    
  177 - cssVariableBridge — produces --af-color-…, --af-spacing-… CSS custom    
  properties so the Dash surface (and any non-React island) can read the same   
  tokens. This is what enables the dual-surface vision in §1.\n 178 \n 179      
  #### Back-compat shims\n 180 - widgets/src/theme/legacy/ exports              
  rankevolve's old names (createAppTheme(name, mode)) wrapping the new API for  
  one minor version, then removed in Phase 6.\n 181 \n 182 ### 2.4 Unified      
  Widget Contract (Decision D)\n 183 \n 184 Shared schema name: WidgetSpec.     
  Python is the source of truth (widget_protocol.py); a generator emits JSON    
  Schema; TS bindings are generated from the JSON Schema.\n 185 \n 186 text\n   
  187 WidgetSpec = {\n 188   id:        string                # stable client   
  id\n 189   kind:      string                # discriminator: "approval" |     
  "choice" | "confirmation" | "multiple_choice" |\n 190                         
  # "single_choice" | "text_input" | "conversation_tool" | "markdown" |         
  "image" |\n 191                                    # "table" | "plot" |       
  <custom>\n 192   version:   int                   # integer major; minor      
  changes are additive (OQ-7)\n 193   title?:    string\n 194   description?:   
  string\n 195   payload:   Record<string, any>   # widget-kind-specific        
  (schema-validated)\n 196   actions?:  Array<{ id; label; style?; payload?:    
  any }>\n 197   state?:    "pending" | "submitted" | "expired" | "error"\n     
  198   created_at: string               # ISO-8601\n 199   metadata?:          
  Record<string, any>   # tracing, agent ids, timestamps\n 200 }\n 201 \n 202   
  WidgetAction = {\n 203   widgetId:  string\n 204   actionId:  string\n 205    
  values?:   Record<string, any>   # form-style returns from input widgets\n    
  206   timestamp: string                # ISO-8601\n 207 }\n 208 \n 209 \n     
  210 #### Python side (source of truth)\n 211 - widget_protocol.py (extended,  
  backward-compatible):\n 212   - Discriminated-union envelopes on kind using   
  pydantic.BaseModel.\n 213   - Adds version: int, id: str, created_at:         
  datetime, metadata: dict.\n 214   - class WidgetProtocol(BaseModel) plus      
  subclasses (MarkdownWidget, ImageWidget, TableWidget, ChoiceWidget,           
  FormWidget, PlotWidget, ApprovalWidget, ConfirmationWidget,                   
  MultipleChoiceWidget, SingleChoiceWidget, TextInputWidget,                    
  ConversationToolWidget, CustomWidget).\n 215   - Methods: to_spec() ->        
  WidgetSpec, from_action(action: WidgetAction), serialize_for_react() returns  
  a JSON-serializable envelope consumable over any transport (websocket, SSE,   
  postMessage from a Dash iframe).\n 216   - Exposes WIDGET_SCHEMA (the JSON    
  Schema produced by pydantic).\n 217 - widget_schema.py (new):\n 218           
  python\n 219   def emit_schema(path: pathlib.Path) -> None: ...\n 220   #     
  Invoked via Makefile target / pre-commit hook; writes\n 221   #               
  agent_foundation/ui/widgets/schemas/widget-spec.schema.json\n 222   \n 223    
  \n 224 #### TypeScript side\n 225 - scripts/generate-protocol.ts runs         
  json-schema-to-typescript against widget-spec.schema.json → emits             
  src/protocol/widget.generated.ts (header: // GENERATED — do not edit).\n 226  
  - chat-widgets/WidgetRegistry.ts:\n 227   ts\n 228   type WidgetKind =        
  WidgetSpec[\'kind\'];\n 229   interface WidgetRenderer<K extends WidgetKind>  
  {\n 230     kind: K; version: number;\n 231     component:                    
  React.ComponentType<{ spec: Extract<WidgetSpec, {kind: K}>; onAction: (a:     
  WidgetAction) => void; }>;\n 232   }\n 233   class WidgetRegistry {           
  register(...); get(kind, version); render(spec, onAction);                    
  adapt(fromVersion, toVersion) }\n 234   \n 235   The registry is              
  transport-agnostic and version-aware (per-widget version + adapt() migration  
  hook for forward-compat).\n 236 - chat-widgets/ChatWidgetRenderer.tsx: thin   
  component <ChatWidgetRenderer spec={spec} registry={registry}                 
  onAction={onAction} />. Validates spec against JSON Schema in dev-mode only   
  (opt-out in prod). Provides <UnknownWidgetFallback /> when version/kind       
  lookup fails, with a telemetry event.\n 237 \n 238 #### CI drift check\n 239  
  scripts/check-protocol-drift.sh:\n 240 1. Re-emits widget-spec.schema.json    
  from Python (python -m agent_foundation.ui.widget_schema).\n 241 2. Re-runs   
  generate-protocol.ts.\n 242 3. git diff --exit-code on the generated          
  files.\n 243 \n 244 Wired into pre-commit + CI.\n 245 \n 246 Why              
  headless+typed: this is the only design that satisfies both surfaces (Dash    
  sends JSON; React consumes JSON) without coupling either to the other's       
  framework.\n 247 \n 248 ---\n 249 \n 250 \n 251 ## 3. Phased Migration        
  Plan\n 252 \n 253 Each phase has: scope, deliverables, acceptance criteria,   
  risks, validation, rollback. Phases are sequential; within a phase,           
  sub-items can parallelize. "Done" = acceptance criteria all green + at least  
  one consumer integration test green where applicable.\n 254 \n 255 ### Phase  
  0 — Bootstrap (≈ 2–3 days, no consumer changes)\n 256 Scope: scaffold         
  agent_foundation/ui/widgets/ (package.json, tsconfig, tsup, vitest, lint, CI  
  matrix on MUI 5 & 7, Storybook). Add webui/README.md DEPRECATED notice.       
  Inventory out-of-tree consumers of vendored webui (R-07).\n 257 \n 258        
  Deliverables: empty package builds & publishes a 0.0.0 smoke artifact; CI     
  green; Storybook hosting decided (OQ-7).\n 259 \n 260 Risks: 🟢 Tooling       
  churn.\n 261 \n 262 Validation: pnpm -F @agent-foundation/ui-widgets build    
  && pnpm -F @agent-foundation/ui-widgets test && npm pack succeed in CI.\n     
  263 \n 264 Rollback: delete widgets/ directory; no consumer touched.\n 265    
  \n 266 ### Phase 1 — Theme + Primitives + Hooks (Foundation, ≈ 1 week)\n 267  
  Scope: port primitives (LoadingIndicator, EmptyState, SectionCard,            
  StatusBadge, PersonChip, ProgressBar, QuickLinkButton, PendingReasonPopover,  
  MarkdownRenderer, Button, Card, Stack, Icon, Tooltip), theme/*, generic       
  hooks/* from rankevolve & openteam, reconciling APIs to the token schema.\n   
  268 \n 269 Deliverables\n 270 - widgets/src/{primitives,theme,hooks}/* with   
  Storybook stories per export.\n 271 -                                         
  widgets/src/theme/{tokens,createAppTheme,themeRegistry,ThemeProvider,ThemeSw  
  itcher,cssVariableBridge,legacy}/*.\n 272 - CI: lint + typecheck + unit       
  tests + storybook build.\n 273 \n 274 Acceptance criteria\n 275 - pnpm -F     
  @agent-foundation/ui-widgets build produces ESM + CJS + .d.ts.\n 276 - A      
  scratch app on React 18 + MUI 5 renders every primitive without errors.\n     
  277 - A scratch app on React 19 + MUI 7 renders every primitive without       
  errors.\n 278 - createAppTheme(lightTokens) survives both MUI v5 and v7 type  
  checks.\n 279 - Theme tokens snapshot test passes; 100% of exports have       
  Storybook story + TSDoc.\n 280 \n 281 Risks\n 282 - 🟡 MarkdownRenderer has   
  three subtly-different versions across codebases. Mitigation: pick            
  rankevolve's (smallest deps) as canonical, file diffs as backlog.\n 283 - 🟡  
  Subtle MUI v5↔v7 API drift inside primitives. Mitigation: CI matrix against   
  both; encapsulate MUI calls inside primitives.\n 284 - 🟢 Bundle size growth  
  — mitigated by sub-path exports + size-limit (<25 kB gz for primitives).\n    
  285 \n 286 Validation: jest/vitest + RTL unit tests; visual regression        
  baseline via @storybook/test-runner; type-coverage ≥ 95%.\n 287 \n 288        
  Rollback: package unimported by any consumer; rollback = delete widgets/      
  directory.\n 289 \n 290 ### Phase 2 — Chat Primitives (≈ 1 week)\n 291        
  Scope: promote chat-leaf components, headless w.r.t. transport (no fetch, no  
  websocket).\n 292 \n 293 Deliverables: widgets/src/chat/* — MessageList,      
  MessageBubble, Composer/ChatInput, CommandAutocomplete, StreamingMessage,     
  AgentMessageBubble, ThinkingFold, Breadcrumb, NodeDetailPanel,                
  PromptViewerDrawer, SessionContextBar. Each ships with Storybook + tests +    
  a11y audit (axe).\n 294 \n 295 Acceptance criteria\n 296 - ChatInput visual   
  parity (≤ 2% diff) in openteam, rankevolve, and AgentFoundation/webui demo    
  apps.\n 297 - CommandAutocomplete keyboard nav (arrow/enter/escape) covered   
  by RTL tests.\n 298 - StreamingMessage handles 1 MB streamed chunks at < 8    
  ms/chunk on M-class laptop.\n 299 - WAI-ARIA chat pattern: tab order + ARIA   
  roles verified.\n 300 \n 301 Risks\n 302 - 🔴 Three different ChatInput APIs  
  exist — reconciling on one prop shape risks consumer rewrites. Mitigation:    
  subtask-2 canonical contract + <LegacyChatInputAdapter> wrapper for one       
  minor version.\n 303 - 🟡 Scroll-stick-to-bottom regressions during           
  streaming. Mitigation: dedicated bench in widgets/bench/chat-stream.json.\n   
  304 - 🟡 StreamingMessage differs in markdown handling. Mitigation: pin to    
  Phase 1 MarkdownRenderer.\n 305 - 🟡 Emotion cache duplication if consumer    
  also instantiates emotion. Mitigation: document single CacheProvider          
  ownership at consumer root.\n 306 \n 307 Validation: per-consumer demo app    
  boots and renders sample transcript; perf benchmarks written to               
  widgets/bench/results.json (not stdout).\n 308 \n 309 Rollback: revert        
  sub-path; consumers still on local copies; widgets/src/chat/* can stay        
  (unused).\n 310 \n 311 ### Phase 3 — Chat-Widgets + WidgetRegistry (the       
  contract phase, ≈ 1.5 weeks)\n 312 Scope: deliver the unified WidgetSpec      
  schema, Python ↔ React alignment, and all chat-widget renderers.\n 313 \n     
  314 Deliverables\n 315 - widgets/schemas/widget-spec.schema.json (single      
  source).\n 316 - widgets/src/protocol/widget.generated.ts (generated TS       
  types).\n 317 - agent_foundation/ui/widget_protocol.py extended (additive);   
  new agent_foundation/ui/widget_schema.py emitter.\n 318 -                     
  widgets/src/chat-widgets/builtins/{Approval,Choice,Confirmation,MultipleChoi  
  ce,SingleChoice,TextInput,ConversationTool,Markdown,Image,Table,Plot}Widget.  
  tsx.\n 319 - widgets/src/chat-widgets/{WidgetRegistry.ts,                     
  ChatWidgetRenderer.tsx, legacy/}.\n 320 - End-to-end fixture: Python harness  
  emits a WidgetSpec, React harness renders it, user "submits", React emits a   
  WidgetAction, Python deserializes and validates it.\n 321 \n 322 Acceptance   
  criteria\n 323 - scripts/check-protocol-drift.sh green (CI gate).\n 324 -     
  All built-in widgets round-trip a sample spec/action without data loss.\n     
  325 - Custom-widget extension point covered by a "hello world" test (e.g.,    
  openteam registers a SprintProgressWidget).\n 326 - Version-negotiation:      
  server emits version: 2, client only knows 1 → falls back gracefully + emits  
  telemetry event.\n 327 \n 328 Risks\n 329 - 🔴 Schema design errors           
  propagate to every consumer; backward-incompat changes are painful.           
  Mitigation: explicit version per widget kind +                                
  WidgetRegistry.adapt(fromVersion, toVersion) hook; SemVer-major bump          
  triggers RFC review.\n 330 - 🔴 Drift between Python & TS contracts → broken  
  renders in prod. Mitigation: single JSON Schema source + CI drift gate +      
  integration fixtures.\n 331 - 🟡 Python typing skew (TypedDict vs pydantic    
  vs dataclass). Mitigation: pydantic v2 canonical; provide a TypedDict export  
  for type-only consumers.\n 332 - 🟡 Dev-mode JSON Schema validation may slow  
  rendering. Mitigation: gate on NODE_ENV !== \'production\'.\n 333 \n 334      
  Validation: contract tests (pytest + vitest) cross-validate ≥ 20 spec         
  fixtures both ways; aggregated to widgets/contract/report.json.\n 335 \n 336  
  Rollback: keep version: 1 only; do not require consumers to upgrade; legacy   
  in-tree WidgetRegistry from openteam available behind                         
  widgets/src/chat-widgets/legacy/ re-export for one minor version.\n 337 \n    
  338 ### Phase 4 — Layout (≈ 3–5 days)\n 339 Scope: promote layout-shell       
  components, router-agnostic (slots for content).\n 340 \n 341 Deliverables:   
  widgets/src/layout/* — AppShell/AppHeader, Sidebar, TopBar, Splitter,         
  SettingsDrawer, ConnectionStatusBar, FileViewer, FolderTree. Responsive       
  breakpoints driven by tokens.\n 342 \n 343 Acceptance criteria\n 344 - Three  
  consumers (openteam, rankevolve, AgentFoundation/webui) render the            
  AppHeader+Sidebar shell successfully.\n 345 - No react-router-dom import in   
  widgets/src/layout/*.\n 346 - Layout snapshot tests at 3 breakpoints;         
  theme-switch live test.\n 347 \n 348 Risks\n 349 - 🟡 FileViewer exists in    
  two trees with diverging features; choosing canonical may hide a feature.     
  Mitigation: subtask-2 contract diff; merged superset behind opt-in props.\n   
  350 - 🟡 Routing assumptions — keep router-agnostic; layout takes slot        
  children only.\n 351 - 🟢 Sidebar styling drift. Mitigation: token-driven;    
  Storybook visual diff.\n 352 \n 353 Validation: layout integration tests in   
  each consumer's e2e suite (Playwright); screenshot snapshots into             
  widgets/snapshots/.\n 354 \n 355 Rollback: per-consumer revert of imports;    
  sub-path can remain unused.\n 356 \n 357 ### Phase 5 — Consumer Adoption      
  (openteam, rankevolve, agent_foundation/webui, ≈ 2–4 weeks rolling)\n 358     
  Scope: replace each consumer's local copies of promoted components with       
  @agent-foundation/ui-widgets imports. Publish package to internal npm         
  registry; consumers pin ^0.1.\n 359 \n 360 Per-consumer work\n 361 -          
  openteam (OpenStartup/src/openteam/ui): swap imports from src/shared/*,       
  src/theme/*, src/components/{chat,chat-widgets,layout}/* →                    
  @agent-foundation/ui-widgets/{primitives,theme,chat,chat-widgets,layout}.     
  Keep product-specific dirs (employees, projects, tasks, teams, views,         
  utils/api.js, setupProxy.js). Pin React 18 in package.json (or accept         
  dual-install — OQ-1).\n 362 - rankevolve                                      
  (atlassian-packages/rankevolve/src/webui): swap imports from                  
  src/components/{common,chat,layout,agent,actions,progress,queries,messages}   
  and react/src/components/{hub,views,widgets} → matching                       
  @agent-foundation/ui-widgets namespace. No version bumps needed. Rollout      
  behind their standard release gates (feature flag / LaunchDarkly).\n 363 -    
  agent_foundation/ui/webui: strip promoted components; webui/ retains only     
  app shell (router + pages + auth + theme wiring). After verification,         
  forward-import from @agent-foundation/ui-widgets for one minor version;       
  final deletion at Phase 6 (OQ-3).\n 364 \n 365 Acceptance criteria per        
  consumer\n 366 - App boots; all promoted-component pages render without       
  console errors.\n 367 - Lint/type-check/snapshot/e2e tests pass; bundle       
  delta ≤ +5% of baseline.\n 368 - pnpm why react @mui/material returns single  
  major.\n 369 - No new direct dependency outside §2.2 baseline range.\n 370 -  
  Visual regression diff ≤ 1% on top 10 screens.\n 371 \n 372 Risks\n 373 - 🔴  
  Hidden divergent behavior in openteam chat (custom message types).            
  Mitigation: pre-Phase-5 audit of custom kinds; feature-flag rollout.\n 374 -  
  🔴 Version-skew install errors ("Invalid hook call", two MUIs). Mitigation:   
  each consumer adds resolutions / overrides pinning single React + MUI major;  
  consumer install verification step in CI.\n 375 - 🟡 Visual drift from token  
  re-mapping. Mitigation: migration-codemod per consumer rewrites imports and   
  applies known prop renames.\n 376 - 🟡 Two emotion caches → style flicker.    
  Mitigation: deduplicate via consumer-owned CacheProvider.\n 377 - 🟡 Theme    
  color regressions on openteam dark mode. Mitigation: visual-regression suite  
  gates the PR.\n 378 \n 379 Validation: each consumer's CI passes + manual     
  smoke on primary user flow + screenshot diffs against baseline.\n 380 \n 381  
  Rollback per consumer: PR is a single import-rewrite commit; revert restores  
  local components (still present in tree during the deprecation window).\n     
  382 \n 383 ### Phase 6 — Cleanup & 1.0 (≈ 2 days, post-migration)\n 384       
