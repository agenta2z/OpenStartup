    type: STRING
    default_value: "a436116f-02ce-4520-8fbb-7301462a1674"
  - name: mode                # evaluate | generate
    type: STRING
  - name: models_to_generate_with
    type: STRING
    default_value: "GPT4O_MINI"
  - name: models_to_evaluate_with
    type: STRING
    default_value: "GPT4O_MINI"
  - name: evaluation_metrics
    type: STRING
    default_value: "judge_relevance"
  - name: evaluation_type# general | intent_specific
    type: STRING
    default_value: "general"
  - name: input_column
    type: STRING
  - name: selected_columns
    type: STRING
    default_value: "*"
  - name: excluded_output_columns
    type: STRING
    default_value: "*"
  - name: query_condition# SQL WHERE clause for filtering
    type: STRING
  - name: generate_output_column_name
    type: STRING
produces:
  - name: OUTPUT_TABLE
consumes:
  - name: INPUT_TABLE
```

### Multi-Step Workflow Example
```yaml
module_tasks:
  - step_name: run_aixeval_generation
    module: aixeval_run
    version: 0.0.4
    parameters:
      - name: mode
        value: generate
      - name: models_to_generate_with
        value: SONNET4_V1
      - name: prompt_string
        value: "<your prompt>"
      - name: model_configuration
        value: |
          {"claude_params": {"temperature": 0.4, "max_tokens": 2040}}
      - name: datasource
        value: "byofs3"produces:
      - name: OUTPUT_TABLE
        value: "{{mls_derived_ugc_prefix}}.output_gen"
    consumes:
      - name: INPUT_TABLE
        value: "ali2/my_cool_file.csv"

  - step_name: run_aixeval_evaluation
    module: aixeval_run
    version: 0.0.4
    depends_on: [run_aixeval_generation]
    parameters:
      - name: mode
        value: evaluate
      - name: evaluation_metrics
        value: |
          {"input_output_metrics": ["judge_relevance"],
           "input_metrics": [],
           "output_metrics": ["judge_conciseness"]}
      - name: evaluation_type
        value: "general"
      - name: input_column
        value: "input_text"
    produces:
      - name: OUTPUT_TABLE
        value: "{{mls_derived_ugc_prefix}}.output_eval"
    consumes:
      - name: INPUT_TABLE
        value: "{{mls_derived_ugc_prefix}}.output_gen"
```

**Source**: [HOWTO: Run AIX-eval in MLStudio with examples](https://hello.atlassian.net/wiki/spaces/AM3/pages/4558760839/HOWTO+Run+AIX-eval+in+MLStudio+with+examples), [Recommendation when using ML-Studio for quality-eval for Jira AI features](https://hello.atlassian.net/wiki/spaces/AIDO/pages/4984024339)

