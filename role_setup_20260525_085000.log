  Symmetric MAPE which handles zero values better than standard MAPE"""         
  y_true, y_pred = np.array(y_true), np.array(y_pred) denominator =             
  (np.abs(y_true) + np.abs(y_pred)) / 2 mask = denominator != 0 result =        
  np.zeros_like(y_true, dtype=float) result[mask] = np.abs(y_true[mask] -       
  y_pred[mask]) / denominator[mask] return np.mean(result) * 100 def            
