## 4. Configuration Schema (EVaC YAML Format)

```yaml
experiment:
  meta_data:
    platform: local# local | databricks | ml_studio
    environment: staging     # dev | staging | prod
    experiment_name: example_experiment
    use_case_id: ai-experience-evaluation   # optional
    cloud_id: DummyCloudID-7e92b4a03f1c2d8e4b6ac# optional
    user_id: DummyUserID-7e92b4a03f1c2d8e4b6ac    # optional

  secrets:
    secret_scope: ai-exp-evaluation
    key_uri_secret_key: DATABRICKS-EVAL-ASAP-KEY-DATA-URI
    issuer_secret_key: AIX_ASAP_ISSUER

  metrics:
    - metric: judge_clarity
      columns:
        - input
        - output
        - reference
      model: open_ai_judge_clarity- metric: judge_tone
      columns:
        - input
        - output
      model: gemini_judge_tone
    - metric: word_count_change
      columns:
        - input
        - output

  models:
    open_ai_judge_clarity:
      provider: openai           # openai | google | bedrock
      model_id: GPT_4O_MINI_LATEST
      model_parameters:
        max_tokens: 100
        temperature: 0.5
        top_p: 0.9
    gemini_judge_tone:
      provider: google
      model_id: GEMINI_2_0_FLASH_001
      model_parameters:
        max_tokens: 100
        temperature: 0.5
        top_p: 0.9
    bedrock_judge_clarity:
      provider: bedrock
      model_id: ANTHROPIC_CLAUDE_V3_5_SONNET_V2
      model_parameters:
        max_tokens: 100
        temperature: 0.5
        top_p: 0.9
```

### Legacy config.yaml Structure (Classic Mode)
```yaml
client: ai-gateway

files:
  generate:
    input_file: ../../data/input.csv
    input_prompt: ../../example_prompts/suggest_title.jinja2
    system_instructions: ../../example_prompts/prompts.py
    output_file: ../../data/output/results.csv
  evaluate:
    output_file: ../../data/output/eval_results.csv

column_names:
  generate:
    input_column: content
    output_column: intent_output

models:
  llm_model_judge: GPT4O_MINI  # enum from src/aixeval/models.py
```

**Source**: [EVaC Config](https://hello.atlassian.net/wiki/spaces/~712020bd7ac0e0f2ec43818cd960ee9eb10bb5/pages/5265289571/Evaluations+as+Code+EVaC), [Generate and evaluate with AIX-eval](https://hello.atlassian.net/wiki/spaces/AM3/pages/4241493773/Generate+and+evaluate+with+AI+Experience+Evaluation+Framework+aixeval)

