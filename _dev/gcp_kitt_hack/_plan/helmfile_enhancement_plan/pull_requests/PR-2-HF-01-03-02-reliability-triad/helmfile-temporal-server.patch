# PR-2 / HF-01+03+02 — Reliability triad patch for helmfile.yaml temporal release block
#
# This file is a UNIFIED DIFF in standard `git apply` format.
# Apply with: cd /Users/tchen7/MyProjects/atlassian_packages/gcp_kitt && git apply --check helmfile_enhancement_plan/pull_requests/PR-2-HF-01-03-02-reliability-triad/helmfile-temporal-server.patch
#
# It modifies ONLY helmfile.yaml — the chart-managed YAML for probes is delivered via
# the temporal Helm chart's standard values (server.frontend.livenessProbe etc).
# PDBs are delivered as a separate manifest file (see pdbs.yaml in this PR directory)
# applied via a new postsync hook.

diff --git a/helmfile/helmfile.yaml b/helmfile/helmfile.yaml
--- a/helmfile/helmfile.yaml
+++ b/helmfile/helmfile.yaml
@@ -71,7 +71,9 @@
             enabled: true
             size: 500Gi
             storageClass: "ebs-volume-gp3-encrypted"
+        # HF-03: Redis master 1 → 2 for HA. PDB minAvailable=1 ensures node-drain safety.
         replica:
-          replicaCount: 1
+          replicaCount: 2
           persistence:
             enabled: true
             size: 500Gi
@@ -97,8 +99,49 @@
             - name: default
               retention: 72h
       - server:
-          replicaCount: 1
+          # HF-03: 1 → 2 for HA. Affects frontend/history/matching/worker (the 4 server roles).
+          # Each role becomes a 2-pod Deployment so a single restart doesn't take the role down.
+          replicaCount: 2
           resources:
             requests:
               cpu: 500m
               memory: 1Gi
             limits:
               cpu: 1000m
               memory: 2Gi
+          # HF-01: startupProbe added so kubelet does NOT kill the pod during the
+          # 60-120s Cassandra schema-verification phase. failureThreshold * periodSeconds
+          # gives a 5-minute startup budget; livenessProbe is suppressed until startup succeeds.
+          # Reference: kubernetes.io/docs/concepts/workloads/pods/pod-lifecycle/#container-probes
+          frontend:
+            startupProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 30
+              periodSeconds: 10
+              failureThreshold: 30      # 30 × 10s = 5 min budget
+              timeoutSeconds: 5
+            livenessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 30
+              failureThreshold: 3
+              timeoutSeconds: 5
+            readinessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 10
+              failureThreshold: 3
+              timeoutSeconds: 5
             podAnnotations:
               prometheus.io/scrape: "true"
               prometheus.io/port: "9090"
               prometheus.io/job: "temporal-frontend"
+          history:
+            startupProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 30
+              periodSeconds: 10
+              failureThreshold: 30
+              timeoutSeconds: 5
+            livenessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 30
+              failureThreshold: 3
+              timeoutSeconds: 5
+            readinessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 10
+              failureThreshold: 3
+              timeoutSeconds: 5
+          matching:
+            startupProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 30
+              periodSeconds: 10
+              failureThreshold: 30
+              timeoutSeconds: 5
+            livenessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 30
+              failureThreshold: 3
+              timeoutSeconds: 5
+            readinessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 10
+              failureThreshold: 3
+              timeoutSeconds: 5
+          worker:
+            startupProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 30
+              periodSeconds: 10
+              failureThreshold: 30
+              timeoutSeconds: 5
+            livenessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 30
+              failureThreshold: 3
+              timeoutSeconds: 5
+            readinessProbe:
+              tcpSocket: { port: rpc }
+              initialDelaySeconds: 0
+              periodSeconds: 10
+              failureThreshold: 3
+              timeoutSeconds: 5
@@ -146,7 +189,7 @@
         web:
           enabled: true
-          replicaCount: 1
+          replicaCount: 2          # HF-03: 1 → 2 for HA
           resources:
             requests:
               cpu: 250m
@@ -425,6 +468,15 @@
         args:
           - apply
           - -f
           - patch-prometheus-config-job.yaml
+      # HF-02: PodDisruptionBudgets — block voluntary eviction (kubectl drain) of the
+      # last replica of each Temporal server role + Redis. Without these, a routine
+      # node maintenance evicts our only pod and triggers a Temporal outage even though
+      # we now have replicaCount: 2 (k8s does not auto-protect; it requires explicit PDB).
+      - events: ["postsync"]
+        showlogs: true
+        command: kubectl
+        args:
+          - apply
+          - -f
+          - temporal-pdbs.yaml
       # Fix Cassandra gossip configuration (seed nodes and JVM options)
       - events: ["postsync"]
         showlogs: true
