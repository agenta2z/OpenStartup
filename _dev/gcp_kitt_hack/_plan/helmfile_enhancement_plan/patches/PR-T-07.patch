diff --git a/atlassian_packages/gcp_kitt/helmfile/policy/no_latest_tag.rego b/atlassian_packages/gcp_kitt/helmfile/policy/no_latest_tag.rego
new file mode 100644
index 0000000..8888888
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/policy/no_latest_tag.rego
@@ -0,0 +1,12 @@
+# HF-13: ban :latest container tags in any Job/Deployment.
+package main
+
+deny[msg] {
+  input.kind == "Job"
+  container := input.spec.template.spec.containers[_]
+  endswith(container.image, ":latest")
+  msg := sprintf("HF-13: container %q in %s/%s uses :latest", [container.name, input.kind, input.metadata.name])
+}
+
+deny[msg] {
+  input.kind == "Deployment"
+  container := input.spec.template.spec.containers[_]
+  endswith(container.image, ":latest")
+  msg := sprintf("HF-13: container %q in %s/%s uses :latest", [container.name, input.kind, input.metadata.name])
+}
diff --git a/atlassian_packages/gcp_kitt/helmfile/policy/no_plaintext_password.rego b/atlassian_packages/gcp_kitt/helmfile/policy/no_plaintext_password.rego
new file mode 100644
index 0000000..9999999
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/policy/no_plaintext_password.rego
@@ -0,0 +1,17 @@
+# HF-05: ban high-entropy plaintext password values in YAML.
+package main
+
+deny[msg] {
+  walk(input, [path, value])
+  is_string(value)
+  count(path) > 0
+  last_key := path[count(path)-1]
+  is_string(last_key)
+  contains(lower(last_key), "password")
+  count(value) >= 6
+  not startswith(value, "$(")           # allow env-var refs
+  not startswith(value, "{{")           # allow Helm refs
+  not value == "CHANGE_ME"              # allow placeholder
+  not regex.match("^<.*>$", value)      # allow <PLACEHOLDER>
+  msg := sprintf("HF-05: plaintext password at %v (len=%d). Move to existingSecret.", [path, count(value)])
+}
diff --git a/atlassian_packages/gcp_kitt/helmfile/policy/jmx_must_authenticate.rego b/atlassian_packages/gcp_kitt/helmfile/policy/jmx_must_authenticate.rego
new file mode 100644
index 0000000..aaaaaaa
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/policy/jmx_must_authenticate.rego
@@ -0,0 +1,13 @@
+# HF-15: any pod exposing JMX (7199) must enable -Dcom.sun.management.jmxremote.authenticate=true
+package main
+
+deny[msg] {
+  some i, j
+  container := input.spec.template.spec.containers[i]
+  port := container.ports[j]
+  port.containerPort == 7199
+  env := container.env[_]
+  env.name == "JVM_OPTS"
+  not contains(env.value, "jmxremote.authenticate=true")
+  msg := sprintf("HF-15: container %q exposes JMX on 7199 without authentication", [container.name])
+}
