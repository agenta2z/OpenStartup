From: helmfile-enhancement-plan
Subject: [PATCH] PR-T-09 — Wire temporal-health-check.sh as scheduled CronJob + postsync hook

Closes G9 (health-check script never run automatically).
Branch: obs/temporal-health-cronjob
Depends-on: PR-HF-14 (apply-and-verify hook chain)

The script is TRUTHFUL today; this patch promotes it to a first-class
CronJob (every 5 min) AND wires its first run into the helmfile postsync
chain so a deploy fails fast if the cluster is unhealthy.

The Dockerfile.temporal-tools already exists; we extend it with grpcurl
so stage 8 (gRPC health) actually runs from inside the image.

---
 atlassian_packages/gcp_kitt/helmfile/temporal-health-cronjob.yaml | 56 +++++++++++++++++++
 atlassian_packages/gcp_kitt/helmfile/Dockerfile.temporal-tools    |  3 ++
 atlassian_packages/gcp_kitt/helmfile/helmfile.yaml                |  4 ++
 3 files changed, 63 insertions(+)
 create mode 100644 atlassian_packages/gcp_kitt/helmfile/temporal-health-cronjob.yaml

diff --git a/atlassian_packages/gcp_kitt/helmfile/temporal-health-cronjob.yaml b/atlassian_packages/gcp_kitt/helmfile/temporal-health-cronjob.yaml
new file mode 100644
index 0000000..ccccccc
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/temporal-health-cronjob.yaml
@@ -0,0 +1,56 @@
+# Scheduled health check for the Temporal control plane.
+# Wraps temporal-health-check.sh; runs every 5 min; emits an Event on failure.
+# Authored by helmfile_enhancement_plan/PR-T-09 (2026-05-11).
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: temporal-health
+  namespace: temporal
+  labels:
+    app.kubernetes.io/name: temporal-health
+    app.kubernetes.io/managed-by: helmfile
+    app.kubernetes.io/part-of: temporal
+spec:
+  schedule: "*/5 * * * *"
+  concurrencyPolicy: Forbid
+  failedJobsHistoryLimit: 3
+  successfulJobsHistoryLimit: 1
+  startingDeadlineSeconds: 60
+  jobTemplate:
+    spec:
+      backoffLimit: 1
+      activeDeadlineSeconds: 240
+      ttlSecondsAfterFinished: 600
+      template:
+        spec:
+          restartPolicy: Never
+          serviceAccountName: temporal-health-sa
+          containers:
+            - name: health
+              image: temporal-tools:1.0.0   # built from Dockerfile.temporal-tools (HF-13 pinned)
+              command: ["/bin/bash", "/scripts/temporal-health-check.sh"]
+              env:
+                - name: NAMESPACE
+                  value: temporal
+                - name: TEMPORAL_ADDRESS
+                  value: temporal-frontend.temporal.svc.cluster.local:7233
+              volumeMounts:
+                - name: scripts
+                  mountPath: /scripts
+                  readOnly: true
+              resources:
+                requests:
+                  cpu: 50m
+                  memory: 64Mi
+                limits:
+                  memory: 128Mi
+              securityContext:
+                runAsNonRoot: true
+                runAsUser: 1000
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities:
+                  drop: ["ALL"]
+          volumes:
+            - name: scripts
+              configMap:
+                name: temporal-health-scripts
+                defaultMode: 0755
diff --git a/atlassian_packages/gcp_kitt/helmfile/Dockerfile.temporal-tools b/atlassian_packages/gcp_kitt/helmfile/Dockerfile.temporal-tools
--- a/atlassian_packages/gcp_kitt/helmfile/Dockerfile.temporal-tools
+++ b/atlassian_packages/gcp_kitt/helmfile/Dockerfile.temporal-tools
@@ -10,2 +10,5 @@ RUN apk add --no-cache bash curl jq bind-tools netcat-openbsd
 RUN curl -fsSL https://github.com/fullstorydev/grpcurl/releases/download/v1.9.1/grpcurl_1.9.1_linux_x86_64.tar.gz | tar -xz -C /usr/local/bin grpcurl

+# PR-T-09: install kubectl pinned (was missing; required by temporal-health-check.sh)
+RUN curl -fsSLo /usr/local/bin/kubectl https://dl.k8s.io/release/v1.32.0/bin/linux/amd64/kubectl \
+ && chmod +x /usr/local/bin/kubectl
diff --git a/atlassian_packages/gcp_kitt/helmfile/helmfile.yaml b/atlassian_packages/gcp_kitt/helmfile/helmfile.yaml
--- a/atlassian_packages/gcp_kitt/helmfile/helmfile.yaml
+++ b/atlassian_packages/gcp_kitt/helmfile/helmfile.yaml
@@ -440,3 +440,7 @@ releases:
       - events: ["postsync"]
         showlogs: true
         command: "kubectl"
         args: ["apply", "-f", "test-helloworld-workflow-job.yaml"]
+      - events: ["postsync"]
+        showlogs: true
+        command: "kubectl"
+        args: ["apply", "-f", "temporal-health-cronjob.yaml"]
