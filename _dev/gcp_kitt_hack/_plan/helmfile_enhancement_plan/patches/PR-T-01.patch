From: helmfile-enhancement-plan
Subject: [PATCH] PR-T-01 — Add bitbucket-pipelines.yml with L1+L2+L3 stages

Closes G1 (no CI pipeline).
Adds CI pipeline at gcp_kitt root + pre-commit config in helmfile/.
Branch: ci/helmfile-bitbucket-pipelines

---
 atlassian_packages/gcp_kitt/bitbucket-pipelines.yml      | 89 ++++++++++
 atlassian_packages/gcp_kitt/helmfile/.pre-commit-config.yaml | 32 ++++
 2 files changed, 121 insertions(+)
 create mode 100644 atlassian_packages/gcp_kitt/bitbucket-pipelines.yml
 create mode 100644 atlassian_packages/gcp_kitt/helmfile/.pre-commit-config.yaml

diff --git a/atlassian_packages/gcp_kitt/bitbucket-pipelines.yml b/atlassian_packages/gcp_kitt/bitbucket-pipelines.yml
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/bitbucket-pipelines.yml
@@ -0,0 +1,89 @@
+# Bitbucket Pipelines for atlassian_packages/gcp_kitt/
+# Authored by helmfile_enhancement_plan/PR-T-01 (2026-05-11)
+# Layers: L1 lint  ·  L2 unit  ·  L3 contract
+# Acceptance: every PR must show 3 green parallel steps in <5 min.
+
+image: atlassian/default-image:4
+
+definitions:
+  caches:
+    gomod: $HOME/go/pkg/mod
+    pip:   $HOME/.cache/pip
+
+pipelines:
+  pull-requests:
+    '**':
+      - parallel:
+          - step:
+              name: L1 — lint (YAML / shell / Dockerfile / k8s)
+              script:
+                - cd atlassian_packages/gcp_kitt/helmfile
+                - apt-get update -qq && apt-get install -y -qq shellcheck python3-pip
+                - pip install --quiet yamllint pre-commit
+                - yamllint -c .yamllint.yaml . || (echo "::error:: yamllint failed"; exit 1)
+                - find . -name '*.sh' -print0 | xargs -0 -r shellcheck -S warning
+                - if command -v hadolint >/dev/null 2>&1; then \
+                    find . -name 'Dockerfile*' -print0 | xargs -0 -r -n1 hadolint; \
+                  fi
+                - bash .test-name-lint.sh   # PR-T-12 will install this
+          - step:
+              name: L2 — unit (Go + Python)
+              caches: [gomod, pip]
+              script:
+                - cd atlassian_packages/gcp_kitt/helmfile/dte
+                - go version
+                - go mod download
+                - go vet ./...
+                - go test -race -coverprofile=coverage.out ./...
+                - go tool cover -func=coverage.out | tail -1
+                - awk '/total:/ { gsub("%",""); if ($3+0 < 40.0) { print "FAIL: coverage "$3"% < 40%"; exit 1 } else { print "OK: coverage "$3"% >= 40%" } }' <(go tool cover -func=coverage.out)
+                - cd ../python-app
+                - pip install --quiet pytest requests-mock boto3 moto
+                - pytest -q --maxfail=3
+          - step:
+              name: L3 — contract (helmfile / helm / kubeval / conftest)
+              script:
+                - cd atlassian_packages/gcp_kitt/helmfile
+                - HELMFILE_VER=v0.169.0
+                - HELM_VER=v3.14.4
+                - KUBEVAL_VER=v0.16.1
+                - CONFTEST_VER=v0.55.0
+                - curl -fsSL https://github.com/helmfile/helmfile/releases/download/${HELMFILE_VER}/helmfile_${HELMFILE_VER#v}_linux_amd64.tar.gz | tar -C /usr/local/bin -xz helmfile
+                - curl -fsSL https://get.helm.sh/helm-${HELM_VER}-linux-amd64.tar.gz | tar -xz -C /tmp && mv /tmp/linux-amd64/helm /usr/local/bin/
+                - curl -fsSL https://github.com/instrumenta/kubeval/releases/download/${KUBEVAL_VER}/kubeval-linux-amd64.tar.gz | tar -xz -C /usr/local/bin kubeval
+                - curl -fsSL https://github.com/open-policy-agent/conftest/releases/download/${CONFTEST_VER}/conftest_${CONFTEST_VER#v}_Linux_x86_64.tar.gz | tar -xz -C /usr/local/bin conftest
+                - helmfile --version && helm version --short && kubeval --version && conftest --version
+                - helmfile --no-color lint --skip-deps
+                - helmfile --no-color template --skip-deps | kubeval --strict --ignore-missing-schemas
+                - if [ -d policy ]; then conftest test --policy policy *-job.yaml helmfile.yaml; fi
+
+  branches:
+    main:
+      - step:
+          name: Build & push (placeholder)
+          script:
+            - echo "Add image-build steps here once HF-13 image-pinning lands"
diff --git a/atlassian_packages/gcp_kitt/helmfile/.pre-commit-config.yaml b/atlassian_packages/gcp_kitt/helmfile/.pre-commit-config.yaml
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/.pre-commit-config.yaml
@@ -0,0 +1,32 @@
+# Pre-commit hooks for the helmfile/ package.
+# Install with: cd atlassian_packages/gcp_kitt/helmfile && pre-commit install
+# Authored by helmfile_enhancement_plan/PR-T-01 (2026-05-11)
+
+repos:
+  - repo: https://github.com/pre-commit/pre-commit-hooks
+    rev: v4.6.0
+    hooks:
+      - id: trailing-whitespace
+      - id: end-of-file-fixer
+      - id: check-yaml
+        args: [--allow-multiple-documents]
+      - id: check-added-large-files
+        args: [--maxkb=800]
+      - id: detect-private-key
+      - id: check-merge-conflict
+
+  - repo: https://github.com/adrienverge/yamllint
+    rev: v1.35.1
+    hooks:
+      - id: yamllint
+        args: [-c, .yamllint.yaml]
+
+  - repo: https://github.com/koalaman/shellcheck-precommit
+    rev: v0.10.0
+    hooks:
+      - id: shellcheck
+        args: [-S, warning]
+
+  - repo: local
+    hooks:
+      - id: ban-latest-tags
+        name: Ban :latest container image tags (HF-13)
+        entry: bash -c 'if grep -nE "image:.*:latest" "$@"; then echo "Pin image tag"; exit 1; fi'
+        language: system
+        files: '^atlassian_packages/gcp_kitt/helmfile/.*\.ya?ml$'
