From: helmfile-enhancement-plan
Subject: [PATCH] PR-T-04 — Audit and tighten vacuous Go assertions (template)

Closes G4 (NotNil-only assertions).
Branch: chore/dte-tighten-test-assertions
Depends-on: PR-T-02

This patch is intentionally minimal: it ships an audit script + a CI
guard. The actual assertion-tightening is incremental and per-test;
each tightening becomes its own commit on this branch.

Why a script instead of a one-shot diff?
  - We do not yet know which `assert.NotNil(...)` calls are legitimately
    "smoke" (i.e., the function returning a non-nil pointer is the only
    contract) vs vacuous. A blanket sed would create thousands of
    spurious failures.
  - The audit script names the offending tests; the human/agent then
    decides per-test what the actual contract should be.

---
 atlassian_packages/gcp_kitt/helmfile/dte/scripts/audit-vacuous-tests.sh | 38 ++++++++++++++++++++++
 atlassian_packages/gcp_kitt/helmfile/dte/Makefile                       |  4 +++
 2 files changed, 42 insertions(+)
 create mode 100755 atlassian_packages/gcp_kitt/helmfile/dte/scripts/audit-vacuous-tests.sh

diff --git a/atlassian_packages/gcp_kitt/helmfile/dte/scripts/audit-vacuous-tests.sh b/atlassian_packages/gcp_kitt/helmfile/dte/scripts/audit-vacuous-tests.sh
new file mode 100755
index 0000000..3333333
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/dte/scripts/audit-vacuous-tests.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# audit-vacuous-tests.sh
+# Lists test functions whose body contains ONLY assert.NotNil/require.NotNil
+# (no Equal/True/Contains/etc.). These are candidates for tightening.
+#
+# Usage:  ./scripts/audit-vacuous-tests.sh   [--ci]
+#         --ci    exit non-zero if any vacuous test exists (after baseline shrinks)
+#
+# Authored by helmfile_enhancement_plan/PR-T-04 (2026-05-11).
+set -euo pipefail
+
+ROOT="$(git rev-parse --show-toplevel)/atlassian_packages/gcp_kitt/helmfile/dte"
+THRESHOLD="${BASELINE:-100}"   # initial unknown; first run sets it
+
+vacuous=$(grep -lrE 'func Test[A-Za-z0-9_]+\(' "$ROOT" \
+  | xargs -I{} bash -c '
+      file="$1"
+      awk -v fn="" '\''
+        /^func Test/ { fn=$2; sub(/\(.*/,"",fn); body=""; next }
+        fn != "" { body=body "\n" $0 }
+        /^}/ {
+          if (fn != "" && body !~ /assert\.(Equal|True|False|Contains|Len|EqualValues|JSONEq|ElementsMatch)|require\.(Equal|True|False|Contains|Len|JSONEq)/ \
+               && body ~ /assert\.NotNil|require\.NotNil/) {
+            print FILENAME ":" fn
+          }
+          fn=""
+        }
+      '\'' "$file"' _ {} \
+  | sort -u)
+
+count=$(printf "%s\n" "$vacuous" | sed '/^$/d' | wc -l | tr -d ' ')
+printf "%s\n" "$vacuous"
+echo "----"
+echo "Vacuous-assertion candidates: $count (baseline: $THRESHOLD)"
+
+if [ "${1:-}" = "--ci" ] && [ "$count" -gt "$THRESHOLD" ]; then
+  echo "FAIL: vacuous test count $count exceeds baseline $THRESHOLD"
+  exit 1
+fi
diff --git a/atlassian_packages/gcp_kitt/helmfile/dte/Makefile b/atlassian_packages/gcp_kitt/helmfile/dte/Makefile
--- a/atlassian_packages/gcp_kitt/helmfile/dte/Makefile
+++ b/atlassian_packages/gcp_kitt/helmfile/dte/Makefile
@@ -63,3 +63,7 @@ coverage-report: coverage ## Emit a human-readable HTML report at coverage.html
 .PHONY: coverage-gate
 coverage-gate: coverage ## CI-suitable: exit non-zero if coverage drops below 40%
 	@go tool cover -func=coverage.out | awk '/total:/ { gsub("%",""); if ($$3+0 < 40.0) { print "FAIL: coverage "$$3"% < 40%"; exit 1 } else { print "OK: coverage "$$3"% >= 40%" } }'
+
+.PHONY: audit-vacuous-tests
+audit-vacuous-tests: ## List tests whose only assertion is NotNil (PR-T-04)
+	@bash scripts/audit-vacuous-tests.sh
