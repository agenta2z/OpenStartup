+"""Pytest fixtures for python-app tests.
+
+Authored by helmfile_enhancement_plan/PR-T-05 (2026-05-11).
+"""
+import os
+import pytest
+import requests_mock
+
+
+@pytest.fixture(scope="session")
+def base_url() -> str:
+    """Mocked endpoint; never points at a live cluster."""
+    return os.environ.get("PYTHON_APP_URL", "http://localhost:5000")
+
+
+@pytest.fixture
+def m():
+    """requests-mock session, auto-cleaned after each test."""
+    with requests_mock.Mocker() as mocker:
+        yield mocker
+
+
+@pytest.fixture
+def healthy_app(m, base_url):
+    """Default mocks: /health -> 200, /ready -> 200, /metrics -> 200."""
+    m.get(f"{base_url}/health", json={"status": "ok"})
+    m.get(f"{base_url}/ready", json={"ready": True})
+    m.get(f"{base_url}/metrics", text="up 1\n")
+    return m
