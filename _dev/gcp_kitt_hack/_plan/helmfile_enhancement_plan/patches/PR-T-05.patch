+"""pytest-based API tests for python-app.
+
+Authored by helmfile_enhancement_plan/PR-T-05 (2026-05-11).
+
+Every test makes a real assertion. Every test uses requests-mock so
+nothing reaches a live cluster. CI fails on any FAIL.
+"""
+import pytest
+import requests
+
+
+def test_health_returns_200(healthy_app, base_url):
+    r = requests.get(f"{base_url}/health", timeout=2)
+    assert r.status_code == 200
+    assert r.json()["status"] == "ok"
+
+
+def test_ready_returns_200(healthy_app, base_url):
+    r = requests.get(f"{base_url}/ready", timeout=2)
+    assert r.status_code == 200
+    assert r.json()["ready"] is True
+
+
+def test_metrics_emits_prometheus_text(healthy_app, base_url):
+    r = requests.get(f"{base_url}/metrics", timeout=2)
+    assert r.status_code == 200
+    assert "up 1" in r.text
+
+
+def test_health_500_fails(m, base_url):
+    m.get(f"{base_url}/health", status_code=500)
+    r = requests.get(f"{base_url}/health", timeout=2)
+    assert r.status_code == 500   # asserts we surface the upstream error
+
+
+def test_health_timeout_raises(m, base_url):
+    m.get(f"{base_url}/health", exc=requests.exceptions.Timeout)
+    with pytest.raises(requests.exceptions.Timeout):
+        requests.get(f"{base_url}/health", timeout=2)
+
+
+# TODO: add per-endpoint tests for /api/account/{id}, /api/refresh, etc.
+# Each test from the original test_api.py becomes an assert pair here.
