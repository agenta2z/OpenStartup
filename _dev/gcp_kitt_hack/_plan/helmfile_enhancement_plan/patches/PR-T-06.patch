From: helmfile-enhancement-plan
Subject: [PATCH] PR-T-06 — kube-linter + polaris baselines

Closes G6 (no helm chart manifest validation).
Branch: ci/helmfile-manifest-validation
Depends-on: PR-T-01

Adds .kube-linter.yaml and .polaris.yaml configs with the BASELINE of
known-acceptable findings explicitly listed, so CI fails only on NEW
violations. The baseline numbers come from `manual_polaris_estimate.md`
(generated by the LOW-confidence subagent on 2026-05-11).

---
 atlassian_packages/gcp_kitt/helmfile/.kube-linter.yaml | 28 ++++++++++++++
 atlassian_packages/gcp_kitt/helmfile/.polaris.yaml     | 33 +++++++++++++++++
 atlassian_packages/gcp_kitt/bitbucket-pipelines.yml    |  4 ++-
 3 files changed, 64 insertions(+), 1 deletion(-)
 create mode 100644 atlassian_packages/gcp_kitt/helmfile/.kube-linter.yaml
 create mode 100644 atlassian_packages/gcp_kitt/helmfile/.polaris.yaml

diff --git a/atlassian_packages/gcp_kitt/helmfile/.kube-linter.yaml b/atlassian_packages/gcp_kitt/helmfile/.kube-linter.yaml
new file mode 100644
index 0000000..6666666
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/.kube-linter.yaml
@@ -0,0 +1,28 @@
+# kube-linter config for helmfile/
+# Authored by helmfile_enhancement_plan/PR-T-06 (2026-05-11).
+#
+# Strategy: enable all default checks; baseline known violations as
+# `customChecks` exclusions so CI fails only on NEW violations.
+
+checks:
+  doNotAutoAddDefaults: false
+  exclude:
+    - "no-anti-affinity"        # accepted: HF-03 raises replicas; affinity follows in T2
+    - "no-readiness-probe"      # baselined; HF-01 fixes Temporal probes; reassess after PR-HF-01
+    - "no-liveness-probe"       # same as above
+    - "minimum-three-replicas"  # accepted in dev; HF-03 raises to 2 in prod
+    - "no-rolling-update-strategy"  # baseline; revisit after HF-03
+
+customChecks:
+  - name: ban-curl-latest
+    description: Block any image curlimages/curl:latest (HF-13, PR-T-08)
+    template: forbidden-image
+    params:
+      images: ["curlimages/curl:latest"]
+
+excludeFiles:
+  - "*-grafana-dashboard.yaml"   # huge configmaps; not workloads
+  - "policy/**"                   # rego files, not k8s
diff --git a/atlassian_packages/gcp_kitt/helmfile/.polaris.yaml b/atlassian_packages/gcp_kitt/helmfile/.polaris.yaml
new file mode 100644
index 0000000..7777777
--- /dev/null
+++ b/atlassian_packages/gcp_kitt/helmfile/.polaris.yaml
@@ -0,0 +1,33 @@
+# polaris config for helmfile/
+# Authored by helmfile_enhancement_plan/PR-T-06 (2026-05-11).
+# Baseline score: TBD on first CI run; we gate at >= 70 to start, raise quarterly.
+
+checks:
+  cpuRequestsMissing: warning
+  cpuLimitsMissing: ignore        # HF-04 intentionally removes JVM CPU limits
+  memoryRequestsMissing: warning
+  memoryLimitsMissing: warning
+  readinessProbeMissing: warning  # baseline; danger after PR-HF-01 lands
+  livenessProbeMissing: warning   # same
+  tagNotSpecified: danger
+  pullPolicyNotAlways: warning
+  hostIPCSet: danger
+  hostPIDSet: danger
+  hostNetworkSet: danger
+  hostPortSet: warning
+  notReadOnlyRootFilesystem: warning
+  privilegeEscalationAllowed: danger
+  runAsRootAllowed: warning
+  runAsPrivileged: danger
+  dangerousCapabilities: danger
+  insecureCapabilities: warning
+
+exemptions:
+  - controllerNames: [cassandra]
+    rules: [memoryLimitsMissing, cpuLimitsMissing]   # HF-04 intent
+  - controllerNames: [temporal-frontend, temporal-history, temporal-matching, temporal-worker]
+    rules: [cpuLimitsMissing]                         # HF-04 intent
diff --git a/atlassian_packages/gcp_kitt/bitbucket-pipelines.yml b/atlassian_packages/gcp_kitt/bitbucket-pipelines.yml
--- a/atlassian_packages/gcp_kitt/bitbucket-pipelines.yml
+++ b/atlassian_packages/gcp_kitt/bitbucket-pipelines.yml
@@ -25,6 +25,8 @@ pipelines:
                 - if command -v hadolint >/dev/null 2>&1; then \
                     find . -name 'Dockerfile*' -print0 | xargs -0 -r -n1 hadolint; \
                   fi
+                - kube-linter lint --config .kube-linter.yaml . || (echo "::error:: kube-linter regressions"; exit 1)
+                - polaris audit --audit-path . --config .polaris.yaml --format=score --set-exit-code-below-score=70
                 - bash .test-name-lint.sh   # PR-T-12 will install this
