        "signal": "histogram('databricks.notebook_run.duration_ms').percentile(90)",
        "threshold": 300000,  # 5 minutes
        "duration": "10m", 
        "severity": "critical",
        "description": "P90 notebook run latency exceeds 5 minutes"
    },
    "circuit_breaker_open": {
        "signal": "counter('databricks.circuit_breaker.state_change').filter(state='OPEN')",
        "threshold": 1,
        "duration": "1m",
        "severity": "critical",
        "description": "Databricks circuit breaker opened"
    }
}
