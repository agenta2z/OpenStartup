    def list_runs(
        self,
        use_case: str = None,
        workflow_name: str = None,
        status: str = None,
        limit: int = 20,
    ) -> List[RunSummary]:
        """GET /api/v2/workflow/runs with filters"""
        
    def get_run_metadata(self, run_id: str) -> RunMetadata:
        """GET /api/v2/workflow/ml-studio-run/{runId}/run-metadata"""
        
    # === Blueprint Management (§6SOP-1) ===
    
    def get_latest_blueprint(
        self,
        use_case: str,
        workflow_name: str,
        workflow_type: str = "RELEASED",
    ) -> Blueprint:
