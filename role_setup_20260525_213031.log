## 8. Shared `atlassian_ml_platform` Base Client Design Derivation

### Design Elements (Synthesized from all patterns above)

```python
@dataclass
class BaseClientConfig:
    """Universal config for all ML Platform API wrappers."""
    service_name: str
    environment: str  # Auto from ENVIRONMENT env var
    kill_switch_key: str  # Feature gate key for global disable
    circuit_breaker_config: CircuitBreakerConfig
    retry_config: RetryConfig
    metrics_prefix: str  # SignalFx metric namespace
    auth_method: str = "service_proxy"  # service_proxy | asap | slauth

class AtlassianMLPlatformBaseClient:
    """
    Abstract base for all ML Platform tool wrappers.
    
    Reusable production patterns:
    1. Kill-switch check →2. Circuit breaker → 3. Rate-limit check → 4. Execute → 5. Emit metrics
    """
    
    # Subclasses set these
    _SERVICE_NAME: str
    _KILL_SWITCH_KEY: str
    _METRICS_PREFIX: str
    
    def __init__(self, config: BaseClientConfig):
        self._config = config
        self._cb = CircuitBreaker(config.circuit_breaker_config)
        self._metrics = SignalFxEmitter(config.metrics_prefix)
    async def _execute_with_resilience(self, method, url, body, **kwargs):
        """
        Standard execution pipeline:
        1. Kill-switch gate
        2. Circuit breaker gate
        3. Request execution with retry + backoff
        4. Metrics emission (latency, status, tokens)
        5. Rate-limit header parsing and backoff
        """
        # Check kill-switch
        if await self._is_killed():
            self._metrics.increment(f"{self._METRICS_PREFIX}.killed")
            raise ServiceDisabledException(self._KILL_SWITCH_KEY)
        
        # Circuit breaker
        async with self._cb.protect() as cb:
            for attempt in range(self._config.retry_config.max_retries):
                try:
                    response = await self._http_call(method, url, body, **kwargs)
                    
                    # Record success metrics
                    self._metrics.record_latency(response.latency_ms)
                    self._metrics.increment(f"status.{response.status_code}")
                    
                    if response.status_code == 429:
                        rate_limit_type = response.headers.get("X-RateLimit-Type")
                        retry_after = int(response.headers.get("Retry-After", 60))
                        self._metrics.increment(f"rate_limited.{rate_limit_type}")
                        
                        if attempt < self._config.retry_config.max_retries - 1:
                            await asyncio.sleep(min(retry_after, 120))
                            continue
                        raise RateLimitedException(rate_limit_type, retry_after)
                    
                    if response.status_code >= 500:
                        cb.record_failure()
                        if attempt < self._config.retry_config.max_retries - 1:
                            await asyncio.sleep(2 ** attempt)
                            continue
                        raise UpstreamErrorException(response.status_code)
                    
                    cb.record_success()
                    return response.json()
                    
                except (ConnectionError, TimeoutError) as e:
                    cb.record_failure()
                    if attempt < self._config.retry_config.max_retries - 1:
                        await asyncio.sleep(2 ** attempt)
                        continue
                    raise
```

