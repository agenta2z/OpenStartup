## 5. Recommended Wrapper Shape

### Design Principles (Derived from SDK v7 + Production Patterns)

Based on the responsible-ai-api and Anti-Abuse Go client patterns:

```python
from dataclasses import dataclass
from typing import Optional, AsyncIterator, Dict, Any, List
import os

@dataclass
class AIGatewayConfig:
    """Configuration auto-resolved from environment."""
    base_url: str = None# Auto from MESH_DEPENDENCY_AI_GATEWAY_BASE_URL or ENVIRONMENT
    use_case_id: str = None  # Required
    cloud_id: str = None  # Required
    user_context: str = None  # UCT token (recommended)
    environment: str = None  # dev/staging/prod — auto-resolves base_url
    timeout_seconds: float = 30.0
    max_retries: int = 3
    
    @classmethod
    def from_env(cls) -> "AIGatewayConfig":
        """Auto-configure from environment variables."""
        env = os.getenv("ENVIRONMENT", "staging")
        base_url = os.getenv("MESH_DEPENDENCY_AI_GATEWAY_BASE_URL") or {
            "dev": "https://ai-gateway.dev-east.atl-paas.net",
            "staging": "https://ai-gateway.stg-east.atl-paas.net",
            "prod": "https://ai-gateway.prod-east.atl-paas.net",
        }.get(env)
        return cls(
            base_url=base_url,
            use_case_id=os.getenv("AI_GATEWAY_USE_CASE_ID"),
            cloud_id=os.getenv("AI_GATEWAY_CLOUD_ID"),
            environment=env,
        )


class AtlassianMLPlatformBaseClient:
    """Shared base client for all ML Platform API wrappers.
    
    Provides:
    - Auto-configured auth (ASAP via service proxy / SLAuth for local)
    - Circuit breaker (Resilience4j pattern)
    - Kill-switch (feature gate check before every call)
    - Per-tenant rate limit awareness
    - SignalFx metrics emission
    - Retry with exponential backoff
    - Request correlation (trace ID propagation)
    """
    
    def __init__(self, config: AIGatewayConfig):
        self.config = config
        self._circuit_breaker = CircuitBreaker(
            failure_threshold=5,
            recovery_timeout_seconds=30,
            half_open_max_requests=3,
        )
        self._kill_switch_key: str = ""# Override in subclasses
    
    def _default_headers(self) -> Dict[str, str]:
        """Headers injected on every request."""
        headers = {
            "Content-Type": "application/json",
            "X-Atlassian-UseCaseId": self.config.use_case_id,
            "X-Atlassian-CloudId": self.config.cloud_id,
        }
        if self.config.user_context:
            headers["User-Context"] = self.config.user_context
        return headers
    
    async def _execute(self, method: str, path: str, body: Dict) -> Dict:
        """Execute with circuit breaker, kill-switch, and retry."""
        #1. Kill-switch check
        if self._is_killed():
            raise ServiceKilledException(self._kill_switch_key)
        
        # 2. Circuit breaker check
        if not self._circuit_breaker.allow_request():
            raise CircuitOpenException()
        
        # 3. Execute with retry
        # ... exponential backoff, respecting Retry-After header on 429
        pass


class AIGatewayRoutingClient(AtlassianMLPlatformBaseClient):
    """
    Multi-vendor LLM routing client via AI Gateway.
    Maps to §3.2 (Model Invocation) and §5.1 (Multi-Model Orchestration).
    """
    
    _kill_switch_key = "ai-employee.ai-gateway.enabled"
    
    async def chat(
        self,
        messages: List[Dict[str, Any]],
        model: str,
        *,
        temperature: float = 0.7,
        max_tokens: int = 4096,
        stream: bool = False,
        tools: Optional[List[Dict]] = None,
        fallback_model: Optional[str] = None,
        fallback_strategy: str = "DEFAULT",
        additional_request_fields: Optional[Dict] = None,
    ) -> Dict[str, Any]:
        """Unified V2 chat completion.
        
        Args:
            model: Canonical model ID (e.g., "anthropic:claude-opus-4-6")
            fallback_model: Fallback if primary fails
            fallback_strategy: DEFAULT | ENFORCED | NONE
        """
        body = {
            "platform_attributes": {
                "model": model,
            },
            "request_payload": {
                "messages": messages,
                "temperature": temperature,
                "max_tokens": max_tokens,
                "stream": stream,
            }
        }
        if tools:
            body["request_payload"]["tools"] = tools
            body["request_payload"]["tool_choice"] = "auto"
        if fallback_model:
            body["platform_attributes"]["fallback"] = {
                "model": fallback_model,
                "strategy": fallback_strategy,
            }
        if additional_request_fields:
            body["additional_request_fields"] = additional_request_fields
        
        return await self._execute("POST", "/v2/chat", body)
    
    async def chat_stream(self, messages, model, **kwargs) -> AsyncIterator[Dict]:
        """Streaming variant — returns SSE events."""
        kwargs["stream"] = True
        # ... SSE parsing logic
        pass
    
    async def invoke_passthrough(
        self,
        endpoint: str,  # CHAT_COMPLETIONS | MESSAGES | GENERATE_CONTENT
        preferred_model: str,
        request_payload: Dict,
        *,
        fallback_model: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        V2 pass-through invoke — provider-native payload, gateway handles routing.
        Response includes platform_attributes showing what actually served.
        """
        body = {
            "platform_attributes": {
                "endpoint": endpoint,
                "preferred_model": preferred_model,
            },
            "request_payload": request_payload,
        }
        if fallback_model:
            body["platform_attributes"]["fallback_model"] = fallback_model
        
        return await self._execute("POST", "/v2/invoke", body)
```

