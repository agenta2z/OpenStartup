## Recommended Wrapper Shape

Based on all findings, the recommended wrapper for the MLE Agent tool:

```python
from atlassian_ml_platform.base_client import AtlassianMLPlatformBaseClient

class MLStudioClient(AtlassianMLPlatformBaseClient):
    """ML Studio Orchestrator API wrapper for MLE Agent"""
    
    SERVICE_AUDIENCE = "ml-studio-orchestrator"
    
    # === Job Submission (§2#3) ===
    
    def submit_workflow(
        self,
        descriptor: dict | str,# YAML string or parsed dict
        env: str = "staging",    # staging | prod
        use_case: str = None,
    ) -> WorkflowRun:
        """Full create → publish → run flow"""
        #1. POST /api/v2/workflow/blueprint (JSON body)
        # 2. POST /api/v2/workflow/blueprint/{id}/publish
        # 3. POST /api/v2/workflow/blueprint/{id}/run
        def run_blueprint(
        self,
        blueprint_id: str,
        overrides: dict = None,
    ) -> WorkflowRun:
        """Run existing published blueprint, optionally with runtime overrides"""
        # POST /api/v2/workflow/blueprint/{id}/run
        
    # === Job Inspection (§5.1) ===
    
    def get_run_status(self, run_id: str) -> RunStatus:
        """GET /api/v2/workflow/runs/{runId}"""
        
    def poll_until_complete(
        self, 
        run_id: str, 
        interval_sec: int = 30,
        timeout_sec: int = 7200,
    ) -> RunResult:
        """Poll until terminal state"""
        
    def list_runs(
        self,
        use_case: str = None,
        workflow_name: str = None,
        status: str = None,
        limit: int = 20,
    ) -> List[RunSummary]:
        """GET /api/v2/workflow/runs with filters"""
        
    def get_run_metadata(self, run_id: str) -> RunMetadata:
        """GET /api/v2/workflow/ml-studio-run/{runId}/run-metadata"""
        
    # === Blueprint Management (§6SOP-1) ===
    
    def get_latest_blueprint(
        self,
        use_case: str,
        workflow_name: str,
        workflow_type: str = "RELEASED",
    ) -> Blueprint:
        """GET /api/v2/workflow/blueprints?use_case=X&workflow_name=Y&workflow_type=Z"""
        
    def get_blueprint(self, blueprint_id: str) -> Blueprint:
        """GET /api/v2/workflow/blueprint/{id}"""
```

**Auth Configuration:**
```python
# ASAP token for service-to-service
auth_config = {
    "type": "asap",
    "issuer": "micros/mle-agent",  # or whatever service name
    "audience": "ml-studio-orchestrator",
    "key_id": "<from-secrets>",
    "private_key": "<from-secrets>",
}

# OR SLAuth for employee-context
auth_config = {
    "type": "slauth",
    "audience": "ml-studio-orchestrator",
    "group": "<use-case-group>",
}
```

