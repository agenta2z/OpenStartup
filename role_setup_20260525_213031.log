        self,
        descriptor: dict | str,# YAML string or parsed dict
        env: str = "staging",    # staging | prod
        use_case: str = None,
    ) -> WorkflowRun:
        """Full create → publish → run flow"""
        #1. POST /api/v2/workflow/blueprint (JSON body)
        # 2. POST /api/v2/workflow/blueprint/{id}/publish
        # 3. POST /api/v2/workflow/blueprint/{id}/run
        def run_blueprint(
        self,
        blueprint_id: str,
        overrides: dict = None,
    ) -> WorkflowRun:
        """Run existing published blueprint, optionally with runtime overrides"""
        # POST /api/v2/workflow/blueprint/{id}/run
        
    # === Job Inspection (§5.1) ===
    
    def get_run_status(self, run_id: str) -> RunStatus:
        """GET /api/v2/workflow/runs/{runId}"""
        
    def poll_until_complete(
        self, 
        run_id: str, 
