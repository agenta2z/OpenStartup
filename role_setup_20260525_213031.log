## 9. Shared `atlassian_ml_platform` Base-Client Design

### Derived from Production Patterns

Based on the responsible-ai-api codebase patterns and Atlassian-wide conventions:

```python
"""
atlassian_ml_platform/base_client.py

Shared base client for all ML Platform API-wrapper tools.
Reuses patterns from responsible-ai-api:
- Circuit breaker (pybreaker-style)
- Kill-switch integration (Switcheroo/Statsig)
- ASAP authentication via Service Proxy egress
- Per-tenant rate-limit awareness
- Metric emission (SignalFx-compatible)
- Fail-open semantics with configurable gates
"""

import os
from dataclasses import dataclass
from enum import Enum
from typing import Optional, Callable, Any
import httpx
import time


class CircuitState(Enum):
    CLOSED = "closed"
    OPEN = "open"
    HALF_OPEN = "half_open"


@dataclass
class CircuitBreakerConfig:
    fail_max: int = 30  # from responsible-ai-api triton_circuit_breaker
    reset_timeout: float = 60.0  # seconds before OPEN → HALF_OPEN
    half_open_max_calls: int = 5


@dataclass
class RateLimitConfig:
    enabled: bool = False
    capacity: int = 100# tokens
    refill_rate: float = 10.0  # tokens/sec
    key_extractor: Optional[Callable] = None  # e.g., extract tenant_id


class AtlassianMLPlatformBaseClient:
    """
    Base client for ML Platform API wrappers.
    
    Provides:
    1. ASAP auth via Service Proxy egress (zero-config)
    2. Circuit breaker with configurable fail_max
    3. Kill-switch integration (feature gates)
    4. Per-key (tenant) rate limiting
    5. Fail-open semantics
    6. Metric emission hooks
    """
    
    def __init__(
        self,
        service_name: str,
        circuit_breaker_config: CircuitBreakerConfig = CircuitBreakerConfig(),
        rate_limit_config: RateLimitConfig = RateLimitConfig(),
        timeout: float = 6.0,  # 6s from responsible-ai-api configured ceiling
        retries: int = 1,
    ):
        self.service_name = service_name
        self.timeout = timeout
        self.retries = retries
        
        # Auth: Service Proxy egress handles ASAP token generation
        mesh_env_key = f"MESH_DEPENDENCY_{service_name.upper().replace('-','_')}_BASE_URL"
        self.base_url = os.environ.get(mesh_env_key, "")
        self._egress_headers = {"X-SLAuth-Egress": "true"}
        
        # Circuit breaker state
        self._cb_config = circuit_breaker_config
        self._cb_state = CircuitState.CLOSED
        self._cb_fail_count = 0
        self._cb_last_failure_time: Optional[float] = None
        self._cb_half_open_calls = 0
        
        # Rate limiting
        self._rl_config = rate_limit_config
        self._rl_buckets: dict = {}  # key → (tokens, last_refill_time)
        
        # Metrics
        self._metrics_prefix = f"ml_platform.{service_name}"
    
    # --- Circuit Breaker ---
    
    def _check_circuit(self) -> bool:
        """Returns True if request should proceed."""
        if self._cb_state == CircuitState.CLOSED:
            return True
        elif self._cb_state == CircuitState.OPEN:
            elapsed = time.time() - (self._cb_last_failure_time or 0)
            if elapsed >= self._cb_config.reset_timeout:
                self._cb_state = CircuitState.HALF_OPEN
                self._cb_half_open_calls = 0
                return True
            return False
        else:  # HALF_OPEN
            return self._cb_half_open_calls < self._cb_config.half_open_max_calls
    
    def _record_success(self):
        if self._cb_state == CircuitState.HALF_OPEN:
            self._cb_state = CircuitState.CLOSED
            self._cb_fail_count = 0
        elif self._cb_state == CircuitState.CLOSED:
            self._cb_fail_count = 0
    
    def _record_failure(self):
        self._cb_fail_count += 1
        self._cb_last_failure_time = time.time()
        if self._cb_state == CircuitState.HALF_OPEN:
            self._cb_state = CircuitState.OPEN
        elif self._cb_fail_count >= self._cb_config.fail_max:
            self._cb_state = CircuitState.OPENself._emit_metric(f"{self._metrics_prefix}.circuit_breaker.opened", 1)
    
    # --- Kill Switch ---
    
    def _should_fail_open(self, operation: str) -> bool:
        """Check feature gate for fail-open. Pattern from feature_service.py."""
        gate_name = f"{self.service_name}_should_fail_open_{operation}"
        return self._check_gate(gate_name)
    
    def _check_gate(self, gate_name: str) -> bool:
        """Check Switcheroo/Statsig feature gate. Override in subclass."""
        # Default: check environment variable fallback
        return os.environ.get(f"GATE_{gate_name}", "false").lower() == "true"
    
    # --- Rate Limiting ---
    
    def _check_rate_limit(self, key: str) -> bool:
        """Token-bucket rate limit check. Returns True if allowed."""
        if not self._rl_config.enabled:
            return True
        
        now = time.time()
        if key not in self._rl_buckets:
            self._rl_buckets[key] = (self._rl_config.capacity, now)
            return True
        
        tokens, last_refill = self._rl_buckets[key]
        elapsed = now - last_refill
        tokens = min(self._rl_config.capacity, tokens + elapsed * self._rl_config.refill_rate)
        
        if tokens >=1:
            self._rl_buckets[key] = (tokens - 1, now)
            return True
        else:
            self._emit_metric(f"{self._metrics_prefix}.rate_limited", 1, tags={"key": key})
            return False
    
    # --- Core Request Method ---
    
    def _execute(self, operation: str, fn: Callable, *args, **kwargs) -> Any:
        """
        Execute an operation with circuit breaker, rate limit, and fail-open.
        
        Pattern from responsible-ai-api's inference_error_handler() context manager.
        """
        # Rate limit check
        rate_key = kwargs.pop("rate_limit_key", "default")
        if not self._check_rate_limit(rate_key):
            raise RateLimitExceeded(key=rate_key, retry_after=1.0 / self._rl_config.refill_rate)
        
        # Circuit breaker check
        if not self._check_circuit():
            if self._should_fail_open(operation):
                self._emit_metric(f"{self._metrics_prefix}.fail_open", 1,tags={"reason": "circuit_breaker", "operation": operation})
                return self._fail_open_response(operation)
            raise CircuitBreakerOpen(service=self.service_name)
        
        # Execute with timeout and retry
        last_error = None
        for attempt in range(self.retries + 1):
            try:
                result = fn(*args, **kwargs)
                self._record_success()
                return result
            except Exception as e:
                last_error = e
                self._record_failure()
                if self._is_retryable(e) and attempt < self.retries:
                    continue
                break
        
        # Failure path
        if self._should_fail_open(operation):
            self._emit_metric(f"{self._metrics_prefix}.fail_open", 1,tags={"reason": "error", "operation": operation})
            return self._fail_open_response(operation)
        raise last_error
    
    # --- Extension points ---
    
    def _fail_open_response(self, operation: str) -> Any:
        """Override in subclass to provide degraded-mode response."""
        raise NotImplementedError
    
    def _is_retryable(self, error: Exception) -> bool:
        """Override to customize retry logic."""
        return isinstance(error, (httpx.TimeoutException, httpx.NetworkError))
    
    def _emit_metric(self, name: str, value: float, tags: Optional[dict] = None):
        """Override to integrate with SignalFx/statsd."""
        pass# Hook for metrics emission
```

### Key Design Decisions
1. **ASAP auth is zero-config**: Service Proxy handles token generation; just send `X-SLAuth-Egress: true`
2. **Circuit breaker mirrors responsible-ai-api**: `fail_max=30`, same CLOSED→OPEN→HALF_OPEN state machine
3. **Kill-switches follow the feature_service.py pattern**: gate naming convention `{service}_should_fail_open_{operation}`
4. **Per-tenant rate limiting is in-process**: Token bucket keyed on tenant_id, no external state needed
5. **Fail-open is the default safety posture** for moderation services (content passes through if moderation fails)
6. **Metrics follow SignalFx conventions**: dotted names with tags, compatible with statsd/datadog protocol

