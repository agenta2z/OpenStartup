# (c) Meta Platforms, Inc. and affiliates. Confidential and proprietary.
#
# Buck-buildable mirror of the pip-installable ``openteam`` package. The
# canonical run path is still ``./src/openteam/run.sh`` (pip/venv); this
# library exists so consumers that need Meta-internal Buck-only deps
# (e.g. ``//msl/metamate/cli:metamate_graphql`` for the ``Metamate``
# inferencer alias registered in
# ``//_tony_dev/CoreProjects/AgentFoundation/src/agent_foundation/common/configs/registered_targets.py``)
# can build a self-contained ``python_binary`` that imports openteam
# without the sibling sys.path injection in ``openteam.bootstrap``.

load("@fbcode_macros//build_defs:python_binary.bzl", "python_binary")
load("@fbcode_macros//build_defs:python_library.bzl", "python_library")

oncall("ml_oncall")

python_library(
    name = "openteam",
    srcs = glob(["openteam/**/*.py"]),
    base_module = "",
    resources = glob([
        # Bundle non-Python assets accessed via ``Path(pkg.__file__).parent``
        # at runtime: YAML topology configs, Jinja2 prompt templates, tool.json
        # manifests, and the hidden .initial.config.yaml whitelist files.
        "openteam/**/*.yaml",
        "openteam/**/*.jinja2",
        "openteam/**/*.json",
        "openteam/**/.initial.config.yaml",
        "openteam/**/.variables.yaml",
    ]),
    typing = False,
    visibility = ["PUBLIC"],
    deps = [
        "fbcode//_tony_dev/CoreProjects/AgentFoundation/src:agent_foundation",
        "fbcode//_tony_dev/CoreProjects/RichPythonUtils/src:rich_python_utils",
        "fbsource//third-party/pypi/attrs:attrs",
        "fbsource//third-party/pypi/fastapi:fastapi",
        "fbsource//third-party/pypi/fastmcp:fastmcp",
        "fbsource//third-party/pypi/httpx:httpx",
        "fbsource//third-party/pypi/jinja2:jinja2",
        "fbsource//third-party/pypi/pydantic:pydantic",
        "fbsource//third-party/pypi/pyyaml:pyyaml",
        "fbsource//third-party/pypi/starlette:starlette",
        "fbsource//third-party/pypi/typer:typer",
        "fbsource//third-party/pypi/uvicorn:uvicorn",
    ],
)

# The API server (run_server.py) with the backends whose SDK is Buck-only: the
# native Metamate backend carries //msl/metamate/sdk, so `native_metamate` is
# available here and nowhere else.
#   buck2 run @fbcode//mode/dev //_tony_dev/CoreProjects/OpenStartup/src:server -- \
#       --real-sessions <dir> --llm-backend native_metamate
# Scripts that start the server themselves (test_e2e_native.py) need this
# binary's interpreter, not just its link-tree on PYTHONPATH: the SDK's thrift
# extensions are linked into the interpreter. From fbcode/:
#   L="$(dirname "$(buck2 build @fbcode//mode/dev //_tony_dev/CoreProjects/OpenStartup/src:server \
#       --show-full-output | cut -d' ' -f2)")/server#link-tree"
#   cd _tony_dev/CoreProjects/OpenStartup && "$L/_bootstrap.sh" \
#       -m test.openteam.server.backends.test_e2e_native --backend native_metamate --model ""
python_binary(
    # @autodeps-skip
    name = "server",
    main_function = "openteam.server.run_server.main",
    deps = [
        ":openteam",
        "//_tony_dev/CoreProjects/AgentFoundation/src/agent_foundation/common/inferencers/agentic_inferencers/conversational_native/session/metamate:metamate",
    ],
)
