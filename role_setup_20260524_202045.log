  sensitive_features: ['region', 'tenant_tier', 'user_segment']
  metrics:
    - equalized_odds_difference
    - demographic_parity_difference
  thresholds:
    equalized_odds_difference: 0.1
    demographic_parity_difference: 0.1reference_group: 'majority'  # or specific group name
