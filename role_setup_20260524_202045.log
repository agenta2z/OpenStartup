## 9. Complete ML Deployment Manifest Schema (Synthesized)

### Proposed Unified Schema

Based on all findings, here is the complete deployment manifest schema that an AI employee skill should generate:

```yaml
# ML Model Deployment Manifest v1.0
schema_version: "1.0"
metadata:
  generated_by: "ml-lifecycle-agent"
  generated_at: "2026-05-25T03:30:00Z"
  author: "tony.chen"
  review_required: true

# === SECTION 1: INTENT & NON-GOALS (from Model Card) ===
intent:
  purpose: "Re-rank search results using cross-encoder architecture"
  business_value: "Improve search NDCG@10 by 5%+ over baseline"
  target_users: ["search-service", "content-searcher"]
  regions: ["us-west-2", "us-east-1", "eu-west-1"]

non_goals:
  - "Not for content moderation or filtering decisions"
  - "Not for user behavioral profiling"
  - "Not a replacement for L1 retrieval — only L2 re-ranking"

# === SECTION 2: MODEL SPECIFICATION (from Registry/Tarot) ===
model:
  name: "l2-reranker-v3"
  version: "202605251200"
  registry_component_id: "abc-123-def"
  artifact_uri: "s3://tarot-prod/components/abc-123/v5/model.tar.gz"
  format: onnx
  architecture: "cross-encoder-deberta-v3-base"
  training_run_id: "mlflow://experiment-42/run-789"
  lineage:
    training_data: "ml_ugc_derived_prod.search_relevance.query_pairs_train_v3"
    evaluation_data: "ml_ugc_derived_prod.search_relevance.query_pairs_eval_v3"
    feature_service: "tecton://search-features/l2-reranker-features"

# === SECTION 3: INFRASTRUCTURE (from Service Descriptor / TEAMServe) ===
infrastructure:
  serving_platform: teamserve  # teamserve | sagemaker | launchpad
  container:
    chart: triton-server
    image: "docker.atl-paas.net/triton-server:24.01-py3"
    backend: pythoncompute:
    instance_type: g5.2xlarge
    gpu_count: 1
    memory_gb: 32scaling:
    min_replicas: 2
    max_replicas: 10target_gpu_utilization: 0.7regions:
    - region: us-west-2
      replicas: 3cluster: teamserve-prod-uswest2
    - region: us-east-1
      replicas: 3
      cluster: teamserve-prod-useast1
    - region: eu-west-1
      replicas: 2
      cluster: teamserve-prod-euwest1

# === SECTION 4: DEPLOYMENT STRATEGY (from Spinnaker DSL) ===
deployment:
  strategy: progressive-canary
  deploy_window:
    periods: ["09:00-17:00"]
    days: [Monday, Tuesday, Wednesday, Thursday, Friday]
    timezone: "US/Pacific"
    public_holidays: ["US"]
  stages:
    - name: staging-validation
      environment_type: staging
      regions: [stg-west2]
      traffic_percent: 100
      validation:
        - smoke_test
        - load_test
        - batch_inference_comparison
      soak_time:2h
      manual_approval: false
    - name: production-canary
      environment_type: production
      progressive_rollout:
        - percent: 5
          soak_time: 15m
        - percent: 25
          soak_time: 30m
        - percent: 50
          soak_time: 30m
        - percent: 100
          soak_time: 1h
      canary_analysis:
        warmup_period: 5m
        analysis_interval: 10m
        pass_score: 70
        marginal_score: 50
      deploy_order:
        - regions: [us-west-2]# Single region firstsoak_time: 1h- regions: [us-east-1, eu-west-1]  # Remaining in parallel

# === SECTION 5: INVARIANTS & MONITORING (from Canary/PDV) ===
invariants:
  - name: latency_p99
    metric: "triton.inference.latency_p99_ms"
    threshold: 200
    operator: less_than
    enforcement: hard# hard = auto-rollback, soft = alert only- name: error_rate
    metric: "triton.inference.error_rate_5xx"
    threshold: 0.01
    operator: less_than
    enforcement: hard
  - name: prediction_quality
    metric: "model.online_ndcg_at_10"
    baseline_comparison: true
    regression_tolerance: 0.02
    statistical_test: mann_whitney_u
    confidence_level: 0.95
    enforcement: hard
  - name: gpu_memory
    metric: "gpu.memory_utilization"
    threshold: 0.90
    operator: less_than
    enforcement: soft
  - name: throughput
    metric: "triton.inference.requests_per_second"
    threshold: 100# Minimum expected
    operator: greater_than
    enforcement: soft

# === SECTION 6: RISK ASSESSMENT===
risk:
  classification: medium-risk  # low-risk | medium-risk | high-risk
  risk_factors:
    - type: data_drift
      likelihood: medium
      impact: high
      detection: "PSI monitor, threshold 0.15"
      mitigation: "Alert + retrain pipeline trigger"
    - type: model_staleness
      likelihood: low
      impact: medium
      detection: "Monthly quality eval vs baseline"
      mitigation: "Scheduled retraining every 30 days"
    - type: capacity_exhaustion
      likelihood: low
      impact: high
      detection: "GPU utilization > 90% sustained10m"
      mitigation: "HPA autoscaling + capacity alert"
  blast_radius:
    affected_services: ["content-searcher", "xpsearch"]
    affected_tenants: "all-commercial"
    estimated_user_impact: "search relevance degradation"

# === SECTION 7: ROLLBACK PLAN ===
rollback:
  strategy: immediate  # immediate | graduated | pause-for-human
  triggers:
    - invariant_violation
    - canary_analysis_failure
    - manual_operator_decision
  procedure:
    - action: revert_traffic
      description: "Route100% traffic to previous model version"
      timeout: 2m
    - action: verify_stable
      description: "Confirm previous model serving healthy"
      check: pollinator_health_check
    - action: notify
      channels: ["#ml-ops-alerts", "#search-oncall"]
      message: "Model {model.name} v{model.version} rolled back in {region}"
  previous_version:
    registry_ref: "l2-reranker-v2/version-id"
    known_good: true

# === SECTION 8: TESTING & VALIDATION ===
testing:
  pre_deployment:
    - name: format_safety_check
      type: gate
      check: "no .pkl/.pt/.h5 formats"
      required: true
    - name: artifact_integrity
      type: gate
      check: "sha256 matches registry"
      required: true
    - name: model_loads
      type: functional
      check: "launchpad startup succeeds"
      required: true
    - name: inference_correctness
      type: functional
      check: "batch inference on eval set within tolerance"
      baseline_mrr_delta: -0.02
      required: true
    - name: latency_benchmark
      type: performance
      check: "perfhammer p99 < 200ms at 100 QPS"
      required: true
  post_deployment:
    - name: pollinator_health
      type: synthetic
      frequency: continuous
      check_id: "poll-l2-reranker-health"
    - name: endpoint_reachability
      type: synthetic
      frequency: "every 1m"
    - name: quality_shadow_comparison
      type: quality
      frequency: "every 1h"
      compare_to: "production_baseline"

# === SECTION 9: MONITORING & OBSERVABILITY ===
monitoring:
  dashboards:
    - name: "Model Performance"
      platform: signalFx
      url: "go/l2-reranker-dashboard"
    - name: "Triton Metrics"
      platform: signalFx
      metrics: [queue_time, inference_latency, gpu_utilization]
  alerts:
    - name: "Latency SLO Breach"
      condition: "p99 > 200ms for 5m"
      severity: high
      notify: ["#search-oncall", "pagerduty://ml-serving"]
    - name: "Error Rate Spike"
      condition: "5xx_rate > 1% for 2m"
      severity: critical
      notify: ["#ml-ops-alerts", "pagerduty://ml-serving"]
  logging:
    prediction_logging: true
    feature_logging: true
    retention: 30d

# === SECTION 10: DOCUMENTATION (Model Card byproduct) ===
model_card:
  generated: true
  sections:
    intended_use: "L2 re-ranking for content search relevance"
    factors: ["query_length", "content_type", "language", "tenant_size"]
    metrics:
      primary: "NDCG@10"
      secondary: ["MRR", "P@5", "inference_latency_p99"]
    evaluation_results:
      overall_ndcg10: 0.72
      slices:
        - slice: "en_queries"
          ndcg10: 0.74
        - slice: "short_queries_lt3_tokens"
          ndcg10: 0.65fairness:
      metrics: [equalized_odds, calibration_ece]
      assessment: "No significant disparity across tenant-size segments"
    ethical_considerations:
      - "Model trained on pseudonymized query logs — no PII retained"
      - "Fairness audit conducted across region/tenant segments"
    limitations:
      - "Degraded quality on non-English queries"
      - "Not tested on code-search use cases"
    caveats:
      - "Requires warm-up period of ~2min after cold start"
      - "Throughput drops30% with batch sizes > 32"
```

